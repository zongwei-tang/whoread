// Shared settings. Machine-specific values live in Local.xcconfig (gitignored if you add it to
// .gitignore; the example is committed).
BUNDLE_ID_PREFIX = com.example
DEVELOPMENT_TEAM =
WHOREAD_EXTENSION_BUNDLE_ID = $(BUNDLE_ID_PREFIX).whoread.extension
// Mach service the daemon / extension listens on. For a system extension Apple's man page says
// the default is <teamID>.<bundleID>.xpc; we set it explicitly.
WHOREAD_MACH_SERVICE = $(DEVELOPMENT_TEAM).$(WHOREAD_EXTENSION_BUNDLE_ID).xpc

#include? "Local.xcconfig"
